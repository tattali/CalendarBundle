{
    "name": "tattali/calendar-bundle",
    "type": "symfony-bundle",
    "description": "Provides event calendar for your Symfony 7+ project. Compatible with API like Google Calendar.",
    "keywords": [
        "fullcalendar",
        "calendar",
        "symfony",
        "symfony calendar"
    ],
    "homepage": "https://github.com/tattali/CalendarBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Théo Attali",
            "email": "theoattali@gmail.com",
            "homepage": "https://theoattali.fr"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "symfony/config": "^7.0",
        "symfony/dependency-injection": "^7.0",
        "symfony/event-dispatcher": "^7.0",
        "symfony/framework-bundle": "^7.0",
        "symfony/http-foundation": "^7.0",
        "symfony/http-kernel": "^7.0",
        "symfony/yaml": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.2 || ^12.5 || ^13.4",
        "friendsofphp/php-cs-fixer": "^3.65",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "infection/infection": "^0.35",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "symfony/event-dispatcher-contracts": "^2.5.3 || ^3.4.3"
    },
    "suggest": {
        "symfony/orm-pack": "To support Doctrine ORM and Migration.",
        "doctrine/mongodb-odm-bundle": "To support MongoDB."
    },
    "autoload": {
        "psr-4": {
            "CalendarBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CalendarBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "infection/extension-installer": false
        }
    }
}
