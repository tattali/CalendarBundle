{
    "name": "tattali/calendar-bundle",
    "type": "symfony-bundle",
    "description": "Provides event calendar for your Symfony 6.4 project. Compatible with Doctrine ORM & ODM, and API like Google Calendar.",
    "keywords": [
        "fullcalendar",
        "calendar",
        "symfony",
        "symfony calendar"
    ],
    "homepage": "https://github.com/tattali/CalendarBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Théo Attali",
            "email": "theoattali@gmail.com",
            "homepage": "https://theoattali.fr"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "symfony/dependency-injection": "^6.4",
        "symfony/event-dispatcher": "^6.4",
        "symfony/framework-bundle": "^6.4"
    },
    "require-dev": {
        "infection/infection": "^0.35",
        "phpspec/prophecy": "^1.15",
        "phpspec/prophecy-phpunit": "^2.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^10.5",
        "symfony/dotenv": "^6.4",
        "symfony/phpunit-bridge": "^6.4",
        "symfony/yaml": "^6.4"
    },
    "suggest": {
        "symfony/orm-pack": "To support Doctrine ORM and Migration.",
        "doctrine/mongodb-odm-bundle": "To support MongoDB."
    },
    "autoload": {
        "psr-4": {
            "CalendarBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CalendarBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": false
        }
    }
}
